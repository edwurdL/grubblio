{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grubblio",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-23",
  // The built client and /images/* are static assets; only the API runs the Worker.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Daily puzzle schedule. Local dev uses a local copy in .wrangler/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grubblio",
      "database_id": "676a8532-7157-4de5-8fea-89f4dea66fdb",
      "migrations_dir": "migrations"
    }
  ],
  // PUZZLE_SECRET is a secret: `npx wrangler secret put PUZZLE_SECRET`.
  "routes": [
    { "pattern": "grubbl.io", "custom_domain": true },
    { "pattern": "www.grubbl.io", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
