{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grubblio",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-23",
  // Better Auth uses node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  // The built client and /images/* are static assets; only the API runs the Worker.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Daily puzzle schedule. Local dev uses a local copy in .wrangler/.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grubblio",
      "database_id": "676a8532-7157-4de5-8fea-89f4dea66fdb",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sender for login codes; grubbl.io must be verified in Resend.
    "EMAIL_FROM": "Grubblio <login@grubbl.io>"
  },
  // Secrets (`npx wrangler secret put <NAME>`): PUZZLE_SECRET, BETTER_AUTH_SECRET,
  // RESEND_API_KEY. Locally, put them in .dev.vars (or leave them out in dev).
  "routes": [
    { "pattern": "grubbl.io", "custom_domain": true },
    { "pattern": "www.grubbl.io", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
